# ==============================================================================
# Application Configuration
# Copy this file to `.env.local` and adjust values for your local environment.
# ==============================================================================

# Public variables (exposed to the browser — prefix with NEXT_PUBLIC_)
NEXT_PUBLIC_APP_NAME="Mitul's Market"
NEXT_PUBLIC_APP_DESCRIPTION="Shop quality tech, electronics, audio, and lifestyle fashion at Mitul's Market."
# Local URL below; leave unset on Vercel so VERCEL_PROJECT_PRODUCTION_URL is used automatically.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_API_BASE_URL="/api"

# Server / Network configuration
API_TIMEOUT_MS="10000"

# Application Authentication & Persistence
# Built-in JSON persistence (.data/store.json) and runnable Google Demo Auth work
# automatically out of the box with no external keys required.
#
# Optional: supply production overrides / real Google OAuth credentials below.
# AUTH_SECRET="replace-with-a-long-random-secret"
# GOOGLE_CLIENT_ID="your-google-oauth-client-id"
# GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-oauth-client-id"

# Optional Cart & Shipping Pricing Configuration
# NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD="999"
# NEXT_PUBLIC_STANDARD_SHIPPING_FEE="99"
# NEXT_PUBLIC_TAX_RATE_PERCENT="0"
